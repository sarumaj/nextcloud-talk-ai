<!-- Psalm against Nextcloud's public API (nextcloud/ocp); what it finds and is accepted for
     now stays in psalm-baseline.xml. -->
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    errorBaseline="psalm-baseline.xml"
    phpVersion="8.2"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="app/talk_ai/lib"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!-- #[\Override] needs PHP 8.3; the app runs on 8.2. -->
        <MissingOverrideAttribute errorLevel="suppress"/>
        <!-- CliProcess starts a command line model with an argv array, which PHP runs without a
             shell: none of it is shell code. Psalm takes proc_open's command for a shell's
             whether it is a string or an array. -->
        <TaintedShell>
            <errorLevel type="suppress">
                <file name="app/talk_ai/lib/Ai/Engine/CliProcess.php"/>
            </errorLevel>
        </TaintedShell>
    </issueHandlers>
    <stubs>
        <file name="stubs/doctrine-dbal.phpstub"/>
    </stubs>
    <extraFiles>
        <directory name="vendor/nextcloud/ocp"/>
    </extraFiles>
</psalm>
